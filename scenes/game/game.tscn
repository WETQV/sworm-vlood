[gd_scene load_steps=7 format=3 uid="uid://game_scene"]

[ext_resource type="Script" path="res://scripts/game/game.gd" id="1_game"]
[ext_resource type="Script" path="res://scripts/enemies/swarm_manager.gd" id="2_swarm"]
[ext_resource type="Script" path="res://scripts/game/death_screen.gd" id="3_death"]
[ext_resource type="Theme" uid="uid://gothic_theme_01" path="res://resources/themes/gothic_theme.tres" id="4_theme"]
[ext_resource type="Material" path="res://resources/shaders/dungeon_ambient_material.tres" id="5_ambient"]
[ext_resource type="PackedScene" uid="uid://game_hud_scene" path="res://scenes/ui/hud.tscn" id="6_hud"]

[node name="Game" type="Node2D"]
script = ExtResource("1_game")

[node name="BackgroundLayer" type="CanvasLayer" parent="."]
layer = -100

[node name="DungeonBackground" type="ColorRect" parent="BackgroundLayer"]
material = ExtResource("5_ambient")
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="PlayerContainer" type="Node2D" parent="."]

[node name="EnemyContainer" type="Node2D" parent="."]

[node name="HUD" parent="." instance=ExtResource("6_hud")]

[node name="SwarmManager" type="Node" parent="."]
script = ExtResource("2_swarm")

[node name="DeathScreen" type="CanvasLayer" parent="."]
layer = 20
visible = false
script = ExtResource("3_death")

[node name="Background" type="ColorRect" parent="DeathScreen"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.04, 0.03, 0.05, 0.85)

[node name="PanelContainer" type="PanelContainer" parent="DeathScreen"]
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -210.0
offset_top = -180.0
offset_right = 210.0
offset_bottom = 180.0
grow_horizontal = 2
grow_vertical = 2
theme = ExtResource("4_theme")

[node name="MarginContainer" type="MarginContainer" parent="DeathScreen/PanelContainer"]
layout_mode = 2
theme_override_constants/margin_left = 32
theme_override_constants/margin_top = 30
theme_override_constants/margin_right = 32
theme_override_constants/margin_bottom = 30

[node name="VBoxContainer" type="VBoxContainer" parent="DeathScreen/PanelContainer/MarginContainer"]
layout_mode = 2
theme_override_constants/separation = 14
alignment = 1

[node name="TitleLabel" type="Label" parent="DeathScreen/PanelContainer/MarginContainer/VBoxContainer"]
layout_mode = 2
theme_override_colors/font_color = Color(0.85, 0.2, 0.2, 1)
theme_override_font_sizes/font_size = 30
text = "ВЫ ПАЛИ В БОЮ"
horizontal_alignment = 1

[node name="FloorLabel" type="Label" parent="DeathScreen/PanelContainer/MarginContainer/VBoxContainer"]
layout_mode = 2
theme_override_colors/font_color = Color(0.75, 0.65, 0.45, 1)
theme_override_font_sizes/font_size = 14
text = "ЭТАЖ 1"
horizontal_alignment = 1

[node name="SubtitleLabel" type="Label" parent="DeathScreen/PanelContainer/MarginContainer/VBoxContainer"]
layout_mode = 2
theme_override_colors/font_color = Color(0.55, 0.5, 0.6, 1)
theme_override_font_sizes/font_size = 13
text = "Рой поглотил ваше тело..."
horizontal_alignment = 1

[node name="HSeparator" type="HSeparator" parent="DeathScreen/PanelContainer/MarginContainer/VBoxContainer"]
layout_mode = 2

[node name="RestartButton" type="Button" parent="DeathScreen/PanelContainer/MarginContainer/VBoxContainer"]
